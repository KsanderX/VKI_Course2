<Window x:Class="Wedding_Agency.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wedding_Agency"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Главное меню" Height="393" Width="420"
        Background="#F6F6F6">
    <Grid>
        <Border Background="White" CornerRadius="14" Padding="32" Margin="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Главное меню"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#2D2D2D"
                           Margin="0,0,0,18"
                           HorizontalAlignment="Center"/>
                <Separator Margin="0,0,0,18"/>
                <Button Content="Список контрактов"
                        Width="220" Height="44" FontSize="16" Margin="0,0,0,12"
                        FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"
                        Click="btnContractView_Click"/>
                <Button Content="Список сотрудников"
                        Width="220" Height="44" FontSize="16" Margin="0,0,0,12"
                        FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"
                        Click="btnEmployeeView_Click"/>
                <Button Content="Выйти из аккаунта"
                        Width="220" Height="44" FontSize="16"
                        FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"
                        Click="btnLoguot_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
