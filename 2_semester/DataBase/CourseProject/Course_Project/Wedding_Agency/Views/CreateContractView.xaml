<Window x:Class="Wedding_Agency.Views.CreateContractView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wedding_Agency.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Добавление нового контракта " Height="650" Width="800">
    <Grid Margin="0,0,0,-86">
        <ScrollViewer Margin="20">
            <StackPanel x:Name="MainPanel" Margin="20">
                
                <CheckBox x:Name="cbNewClient" Content="Добавить нового клиента" Checked="cbNewClient_Checked" Unchecked="cbNewClient_Unchecked"/>

                <StackPanel x:Name="existingClientPanel">
                    <TextBlock Text="Существующий клиент:" Margin="0,10,0,0"/>
                    <ComboBox x:Name="cbClients" DisplayMemberPath="FirstName" SelectedValuePath="IdClient"/>
                </StackPanel>

                <StackPanel x:Name="newClientPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="Имя клиента:"/>
                    <TextBox x:Name="tbFirstName"/>

                    <TextBlock Text="Фамилия клиента:"/>
                    <TextBox x:Name="tbLastName"/>

                    <TextBlock Text="Телефон:"/>
                    <TextBox x:Name="tbPhone"/>

                    <TextBlock Text="Email:"/>
                    <TextBox x:Name="tbEmail"/>

                    <TextBlock Text="Паспортные данные:"/>
                    <TextBox x:Name="tbPassport"/>
                </StackPanel>

                <!-- Контракт -->
                <TextBlock Text="Дата контракта:" Margin="0,10,0,0"/>
                <DatePicker x:Name="dpContractDate"/>

                <TextBlock Text="Дата свадьбы:"/>
                <DatePicker x:Name="dpWeddingDate"/>

                <TextBlock Text="Бюджет:"/>
                <TextBox x:Name="tbBudget"/>

                <TextBlock Text="Описание:"/>
                <TextBox x:Name="tbDescription" Height="60"/>

                <TextBlock Text="Локация:"/>
                <ComboBox x:Name="cbLocation" DisplayMemberPath="Name" SelectedValuePath="IdLocation"/>

                <TextBlock Text="Меню:"/>
                <ComboBox x:Name="cbMenu" DisplayMemberPath="Name" SelectedValuePath="IdMenu"/>

                <TextBlock Text="Дизайн локации:"/>
                <ComboBox x:Name="cbDesign" DisplayMemberPath="Style" SelectedValuePath="IdDesignLocation"/>

                <Button Content="Сохранить" Margin="0,10,0,0" Click="btnSave_Click"/>
                <Button Content="Отмена" Click="btnCancel_Click" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
