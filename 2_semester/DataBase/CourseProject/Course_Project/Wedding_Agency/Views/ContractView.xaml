<Window x:Class="Wedding_Agency.Views.ContractView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Список контрактов" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>      

        <ListView x:Name="ContractListView" Grid.Row="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Margin="5">
                        <TextBlock Text="{Binding ClientName, StringFormat='Клиент: {0}'}" FontSize="14"/>
                        <TextBlock Text="{Binding ContractDate, StringFormat='Дата контракта: {0:D}'}" FontSize="14"/>
                        <TextBlock Text="{Binding WeddingDate, StringFormat='Дата свадьбы: {0:D}'}" FontSize="14"/>
                        <TextBlock Text="{Binding TotalBudget, StringFormat='Бюджет: {0:d}р'}" FontSize="14"/>
                        <TextBlock Text="{Binding Description, StringFormat='Описание: {0}'}"  FontSize="14"/>
                        <TextBlock Text="{Binding LocationName, StringFormat='Локация: {0}'}"  FontSize="14"/>
                        <TextBlock Text="{Binding MenuName, StringFormat='Меню: {0}'}"  FontSize="14"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right">
            <Button Content="Назад" Width="120" Height="40" FontSize="14" Margin="10" Click="btnBack_Click"/>
            <Button Content="Редактировать" Width="120" Height="40" FontSize="14" Margin="10" Click="btnEdit_Click"/>
            <Button Content="Создать новый контракт" Width="180" Height="40" FontSize="14" Margin="10" Click="btnCreateContract_Click"/>
        </StackPanel>
    </Grid>
</Window>