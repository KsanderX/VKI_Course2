<Window x:Class="Wedding_Agency.Views.EditEmployeeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wedding_Agency.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Рудактирование сотрудника" Height="450" Width="370">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Имя:"/>
            <TextBox x:Name="tbFirstName"/>

            <TextBlock Text="Фамилия:"/>
            <TextBox x:Name="tbLastName"/>

            <TextBlock Text="Телефон:"/>
            <TextBox x:Name="tbPhone"/>

            <TextBlock Text="Email:"/>
            <TextBox x:Name="tbEmail"/>

            <TextBlock Text="Логин:"/>
            <TextBox x:Name="tbLogin"/>

            <TextBlock Text="Пароль:"/>
            <TextBox x:Name="tbPassword"/>

            <TextBlock Text="Должность:"/>
            <ComboBox x:Name="cbPositions" DisplayMemberPath="Title" SelectedValuePath="IdPosition"/>

            <Button Content="Сохранить изменения" Click="btnSave_Click" Margin="0,10,0,0"/>
            <Button Content="Отмена" Click="btnCancel_Click" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
