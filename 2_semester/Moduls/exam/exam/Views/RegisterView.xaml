<Window x:Class="exam.Views.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:exam.Views"
        mc:Ignorable="d"
        WindowStartupLocation = "CenterScreen"
        Title="RegisterView" Height="754" Width="800">
    <Grid>
        <StackPanel Margin="225,132,198,20">
            <Label Content="Регистрация" FontSize="22" FontFamily="Arial" HorizontalAlignment="Center"/>
            <Label Content="Имя" FontSize="16" Margin="10"/>
            <TextBox x:Name="tbName"  FontSize="18" Height="30" Margin="10"/>
            <Label Content="Логин" FontSize="16" Margin="10"/>
            <TextBox x:Name="tbLogin"  FontSize="18" Height="30" Margin="10"/>
            <Label Content="Пароль" FontSize="16" Margin="10"/>
            <TextBox x:Name="tbPass"  FontSize="18" Height="30"/>
            <Label Content="Повторите пароль" FontSize="16" Margin="10"/>
            <TextBox x:Name="tbRepeatPass" FontSize="18" Height="30"/>

            <Button x:Name="btnSave" Content="Сохранить" FontSize="16" Margin="10" Click="btnSave_Click"/>
            <Button x:Name="btnOpen" Content="Отмена" FontSize="16" Margin="10" Click="btnOpen_Click"/>
        </StackPanel>
    </Grid>
</Window>
